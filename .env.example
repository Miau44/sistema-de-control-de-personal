# Copy these values into the process environment before starting the application.
# This file is an example; the application does not load .env files automatically.
INSTITUCION=GestionPersonal
ASISTENCIA_DB=instance/kimtek.sqlite3
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_40_CHARACTERS
HTTPS_ONLY=0
AUTO_CLOSE=0

